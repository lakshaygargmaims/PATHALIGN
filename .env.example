# ============================================================
# PATHALIGN AI — Environment Configuration (PRODUCTION)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================
# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=PATHALIGN AI
NEXT_PUBLIC_APP_URL=https://<your-railway-app-name>.up.railway.app
APP_ENV=production

# ── Database (PostgreSQL + pgvector via Railway) ───────────
# Railway creates this automatically. Copy from Railway dashboard.
DATABASE_URL=postgresql://postgres:password@<host>:5432/pathalign?schema=public
# Direct (unpooled) URL used by Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://postgres:password@<host>:5432/pathalign?schema=public

# ── Auth / sessions ────────────────────────────────────────
SESSION_COOKIE_NAME=pathalign_session
SESSION_TTL_HOURS=72
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── AI provider ────────────────────────────────────────────
# demo = offline, rule-based + local RAG fallback (NO KEY needed)
# openai = OpenAI-compatible endpoint
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG retrieval ──────────────────────────────────────────
RAG_MODE=lexical
ENABLE_VECTOR_SEARCH=false

# ── Email notifications (optional) ─────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PATHALIGN AI <no-reply@pathalign.local>

# ── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Storage (generated PDF reports) ────────────────────────
STORAGE_DIR=.storage
