# ============================================================
# PATHALIGN AI — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# Every optional integration has a documented demo/fallback mode.
# ============================================================

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=PATHALIGN AI
NEXT_PUBLIC_APP_URL=http://localhost:3200
APP_ENV=development

# ── Database (PostgreSQL + pgvector) ──────────────────────
# Local dev (Docker): docker run -d --name pathalign-pg -e POSTGRES_USER=pathalign -e POSTGRES_PASSWORD=pathalign -e POSTGRES_DB=pathalign -p 5433:5432 pgvector/pgvector:pg16
DATABASE_URL=postgresql://pathalign:pathalign@localhost:5433/pathalign?schema=public
# Direct (unpooled) URL used by Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://pathalign:pathalign@localhost:5433/pathalign?schema=public

# ── Auth / sessions ───────────────────────────────────────
SESSION_COOKIE_NAME=pathalign_session
SESSION_TTL_HOURS=72
# Long random string (32+ chars). Used to sign session cookies.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── AI provider (provider abstraction) ────────────────────
# demo    = offline, rule-based + RAG-over-local-knowledge fallback (no key needed)
# openai  = any OpenAI-compatible endpoint (OpenAI / OpenRouter / Groq / Ollama)
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── RAG retrieval ─────────────────────────────────────────
# lexical = built-in BM25-style retrieval (no external service needed)
# vector  = pgvector cosine similarity (requires OPENAI_API_KEY for embeddings)
RAG_MODE=lexical
ENABLE_VECTOR_SEARCH=false

# ── Speech-to-text / text-to-speech (optional) ────────────
# When empty, the app uses the browser Web Speech API and shows a clear
# text-based fallback if the browser does not support it.
SPEECH_API_KEY=
SPEECH_STT_URL=
SPEECH_TTS_URL=

# ── Email notifications (optional) ────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PATHALIGN AI <no-reply@pathalign.local>

# ── Maps (OpenStreetMap) ──────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ── Storage (generated PDF reports) ───────────────────────
STORAGE_DIR=.storage
